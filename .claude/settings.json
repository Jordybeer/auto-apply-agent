{
  "permissions": {
    "allow": [
      "Bash(npm audit *)",
      "Bash(npm ls *)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.next/**)",
      "Read(out/**)",
      "Read(dist/**)",
      "Read(public/**)",
      "Read(.git/**)",
      "Read(package-lock.json)",
      "Read(yarn.lock)",
      "Read(pnpm-lock.yaml)",
      "Read(bun.lockb)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(supabase/.branches/**)",
      "Read(supabase/.temp/**)",
      "Read(coverage/**)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.jpeg)",
      "Read(**/*.gif)",
      "Read(**/*.svg)",
      "Read(**/*.ico)",
      "Read(**/*.webp)",
      "Read(**/*.avif)",
      "Read(**/*.mp4)",
      "Read(**/*.mp3)",
      "Read(**/*.woff)",
      "Read(**/*.woff2)",
      "Read(**/*.ttf)",
      "Read(**/*.eot)"
    ]
  }
}
